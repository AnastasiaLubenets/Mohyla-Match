# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin used for Auth email links and post-auth redirects.
# Local development can omit this and use http://localhost:3000 from the request.
# Production must be the deployed origin, for example https://mohyla-match.example.
NEXT_PUBLIC_SITE_URL=

# Server-only privileged key.
# Avoid using it unless a privileged server operation genuinely requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy local alias for the same server-only privileged key.
SUPABASE_SECRET_KEY=

# Server-only shared Faculty verification code.
# Use a long random value in deployed environments. Do not expose it as NEXT_PUBLIC_*.
FACULTY_VERIFICATION_CODE=
